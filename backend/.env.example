# Rama Kripa Estates - backend environment template.
# Copy to .env and fill in real values:  cp .env.example .env

# Port the API listens on.
PORT=5000
# development | production
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Local MongoDB (default for development)
MONGO_URI=mongodb://127.0.0.1:27017/ramakripa
# MongoDB Atlas (SRV connection string). Whitelist your IP in Atlas > Network Access,
# create a database user, then paste the string below and comment the local one out:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/ramakripa?retryWrites=true&w=majority&appName=Cluster0

# --- Auth -----------------------------------------------------------------
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d

# --- CORS -----------------------------------------------------------------
# Origin of the Vite frontend that is allowed to call this API.
CLIENT_URL=http://localhost:5174

# --- Seed admin account ---------------------------------------------------
# Used by `npm run seed` to create the single admin login.
ADMIN_NAME=Rama Kripa Admin
ADMIN_EMAIL=admin@rke.com
ADMIN_PASSWORD=rke@2026

# Cloudinary — media uploads (https://console.cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rama-kripa

# --- Email --------------------------------------------------------------
# Plain SMTP via Nodemailer. Any provider works; swap these values, restart, done.
#
# NOTIFY_EMAIL  the human inbox that receives every new enquiry and every reply a
#               visitor sends back. Usually the owner's Gmail.
# MAIL_FROM     what visitors see in "From". With Gmail SMTP it must be the same
#               Gmail; with Mailtrap Sending / Brevo it must be on a verified domain.
NOTIFY_EMAIL=owner@gmail.com

# Option A — Gmail (no domain needed). Google Account -> Security -> 2-Step
# Verification ON -> App passwords -> create one -> paste the 16 characters.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=owner@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
MAIL_FROM=Rama Kripa Estates <owner@gmail.com>

# Option B — Mailtrap Sending (needs ramakripaestate.com verified in Mailtrap).
# SMTP_HOST=live.smtp.mailtrap.io
# SMTP_PORT=587
# SMTP_USER=api
# SMTP_PASS=<token from Sending Domains -> Integration>
# MAIL_FROM=Rama Kripa Estates <info@ramakripaestate.com>

# Dev — Mailtrap Sandbox catches everything, nothing is delivered.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=<inbox username>
# SMTP_PASS=<inbox password>
# MAIL_FROM=noreply@ramakripaestate.com

# --- Maps ---------------------------------------------------------------
# Optional. When a property is saved with an address but no latitude/longitude,
# the server looks the coordinates up so the map pins the right spot. Without a
# key it uses OpenStreetMap, which is free but thin on Faridabad's sectors and
# simply declines when unsure. With a Google key it reads them properly:
#   console.cloud.google.com -> APIs & Services -> enable "Geocoding API"
#   -> Credentials -> create an API key -> restrict it to that one API
# GOOGLE_MAPS_API_KEY=
