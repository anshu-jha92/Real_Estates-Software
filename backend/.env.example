# Rama Kripa Estates - backend environment template.
# Copy to .env and fill in real values:  cp .env.example .env

# Port the API listens on.
PORT=5000
# development | production
NODE_ENV=development

# --- Database -------------------------------------------------------------
# Local MongoDB (default for development)
MONGO_URI=mongodb://127.0.0.1:27017/ramakripa
# MongoDB Atlas (SRV connection string). Whitelist your IP in Atlas > Network Access,
# create a database user, then paste the string below and comment the local one out:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/ramakripa?retryWrites=true&w=majority&appName=Cluster0

# --- Auth -----------------------------------------------------------------
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d

# --- CORS -----------------------------------------------------------------
# Origin of the Vite frontend that is allowed to call this API.
CLIENT_URL=http://localhost:5174

# --- Seed admin account ---------------------------------------------------
# Used by `npm run seed` to create the single admin login.
ADMIN_NAME=Rama Kripa Admin
ADMIN_EMAIL=admin@rke.com
ADMIN_PASSWORD=rke@2026

# Cloudinary — media uploads (https://console.cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=rama-kripa

# --- Email notifications --------------------------------------------------
# Mailtrap (dev, testing) or Brevo (prod, real SMTP)
# See https://mailtrap.io or https://brevo.com for credentials
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@ramakripaestate.com
